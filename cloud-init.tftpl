#cloud-config
users:
  - name: pavel
    groups: sudo
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH1aldsXuAs62u6zs8rqqAzylhg6foOlY8uOqCadg4MY jonyblaze2019@gmail.com

runcmd:
  - |
    #!/bin/bash
    sleep 10
    mkdir -p /var/www/html
    rm -f /var/www/html/index.html /var/www/html/index.html.var /var/www/html/index.php /var/www/html/index.nginx-debian.html
    IMG_URL="${bucket_image_url}"
    echo "<html><head><meta charset=\"utf-8\"><title>LAMP Group</title></head><body><h1>Привет из Yandex Cloud Instance Group!</h1><img src=\"$IMG_URL\" crossorigin=\"anonymous\" alt=\"Image from Object Storage\"></body></html>" > /var/www/html/index.html
    systemctl restart apache2 || systemctl restart httpd
